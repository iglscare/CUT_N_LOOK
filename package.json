{
  "name": "skyelite",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.8",
  "description": "SkyElite Monorepo - Salon & Spa Product Ecosystem",
  "workspaces": [
    "apps/*",
    "packages/*",
    "database"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=@skyelite/web",
    "dev:admin": "npm run dev --workspace=@skyelite/admin",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "animejs": "^3.2.2"
  }
}
